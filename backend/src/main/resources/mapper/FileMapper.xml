<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.procurement.mapper.FileMapper">
    
    <resultMap id="FileResultMap" type="com.example.procurement.entity.ProcurementFile">
        <id column="file_id" property="fileId"/>
        <result column="procurement_request_id" property="procurementRequestId"/>
        <result column="file_name" property="fileName"/>
        <result column="file_size" property="fileSize"/>
        <result column="file_path" property="filePath"/>
        <result column="upload_time" property="uploadTime"/>
    </resultMap>
    
    <insert id="insertProcurementFile" parameterType="com.example.procurement.entity.ProcurementFile">
        INSERT INTO procurement_file 
        (procurement_request_id, file_name, file_size, file_path, upload_time)
        VALUES 
        (#{procurementRequestId}, #{fileName}, #{fileSize}, #{filePath}, #{uploadTime})
    </insert>
    
    <select id="findProcurementFilesByRequestId" resultMap="FileResultMap">
        SELECT * FROM procurement_file 
        WHERE procurement_request_id = #{procurementRequestId}
        ORDER BY upload_time DESC
    </select>
    
    <select id="findProcurementFileById" resultMap="FileResultMap">
        SELECT * FROM procurement_file 
        WHERE file_id = #{fileId}
    </select>
    
    <delete id="deleteProcurementFileById">
        DELETE FROM procurement_file WHERE file_id = #{fileId}
    </delete>
    
    <delete id="deleteProcurementFilesByRequestId">
        DELETE FROM procurement_file WHERE procurement_request_id = #{procurementRequestId}
    </delete>
    
</mapper>
